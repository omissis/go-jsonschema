{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/arrayParentBounds",
  "type": "object",
  "properties": {
    "licenses": {
      "description": "The array holding the oneOf bounds its own length. The holder replaces the field that checked those bounds, so its shape check applies them along with each variant's own.",
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": { "license": { "type": "string" } },
            "required": ["license"],
            "additionalProperties": false
          }
        },
        {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "object",
            "properties": { "expression": { "type": "string" } },
            "required": ["expression"],
            "additionalProperties": false
          }
        }
      ]
    }
  }
}
