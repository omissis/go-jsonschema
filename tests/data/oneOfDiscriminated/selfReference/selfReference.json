{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/selfReference",
  "$ref": "#/definitions/Pet",
  "definitions": {
    "Pet": {
      "description": "A variant refers back to the oneOf that holds it. The holder is registered before its variants, so Friend resolves to it; before, Friend got a type that was never declared.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": { "const": "dog" },
            "friend": { "$ref": "#/definitions/Pet" }
          },
          "required": ["kind"]
        },
        {
          "type": "object",
          "properties": { "kind": { "const": "cat" } },
          "required": ["kind"]
        }
      ]
    }
  }
}
