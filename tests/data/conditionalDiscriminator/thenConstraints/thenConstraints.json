{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/thenConstraints",
  "description": "The then branch also bounds x, which the validator would not enforce, so detection declines with a warning.",
  "type": "object",
  "properties": {
    "kind": { "type": "string", "enum": ["a", "b"] },
    "x": { "type": "integer" }
  },
  "required": ["kind"],
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "a" } } },
      "then": { "required": ["x"], "properties": { "x": { "minimum": 5 } } }
    }
  ]
}
