{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "validationTime": {
            "anyOf": [
                {
                    "type": "string",
                    "format": "date-time"
                },
                {
                    "type": "null"
                }
            ]
        },
        "eventTime": {
            "description": "Event time as an RFC 3339 timestamp or Unix epoch seconds",
            "anyOf": [
                {
                    "type": "string",
                    "format": "date-time"
                },
                {
                    "type": "integer"
                },
                {
                    "type": "null"
                }
            ]
        }
    }
}
